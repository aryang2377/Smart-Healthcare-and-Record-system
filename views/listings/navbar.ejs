<header class="navbar-wrapper">
  <nav class="navbar">
    <div class="nav-brand-section">
      <a href="/" class="brand-link" title="CareSync Medical Portal">
        <img src="/images/logo.png" alt="CareSync" class="logo-img">
      </a>
    </div>

    <div class="nav-center-menu" id="nav-menu">
      <ul class="nav-links">
        <li>
          <a href="/" class="nav-link" data-path="/">
            <i class="fas fa-hospital"></i> Home
          </a>
        </li>
        <li>
          <a href="/doctors" class="nav-link" data-path="/doctors">
            <i class="fas fa-user-md"></i> Doctors
          </a>
        </li>
        <% if (!currentUser || currentUser.role === 'patient') { %>
          <li>
            <a href="/symptom" class="nav-link" data-path="/symptom">
              <i class="fas fa-robot text-cyan"></i> AI Symptom Checker
            </a>
          </li>
        <% } else if (currentUser.role === 'doctor') { %>
          <li>
            <a href="/doctor/triage" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'doctor-triage') ? 'active' : '' %>" data-path="/doctor/triage">
              <i class="fas fa-robot text-purple"></i> AI Symptom Triage
            </a>
          </li>
        <% } else if (currentUser.role === 'admin') { %>
          <li>
            <a href="/admin/triage" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'admin-triage') ? 'active' : '' %>" data-path="/admin/triage">
              <i class="fas fa-robot text-cyan"></i> AI Symptom Triage
            </a>
          </li>
        <% } %>

        <!-- Role-specific dashboard links -->
        <% if (currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <li>
              <a href="/admin" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'admin-triage') ? '' : 'active-console' %>" data-path="/admin">
                <i class="fas fa-shield-alt text-purple"></i> Admin Console
              </a>
            </li>
          <% } else if (currentUser.role === 'doctor' || currentUser.role === 'receptionist') { %>
            <li>
              <a href="/staff" class="nav-link <%= (typeof activePage !== 'undefined' && activePage === 'doctor-triage') ? '' : 'active-console' %>" data-path="/staff">
                <i class="fas <%= currentUser.role === 'doctor' ? 'fa-stethoscope text-cyan' : 'fa-id-badge text-blue' %>"></i>
                <%= currentUser.role === 'doctor' ? 'Doctor Console' : 'Staff Console' %>
              </a>
            </li>
          <% } else { %>
            <li>
              <a href="/dashboard" class="nav-link active-console" data-path="/dashboard">
                <i class="fas fa-th-large text-emerald"></i> My Dashboard
              </a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <!-- Mobile drawer auth -->
      <div class="mobile-auth-block">
        <div class="mobile-theme-row">
          <div class="mobile-theme-label">
            <i class="fas fa-palette"></i>
            <span>Theme Mode</span>
          </div>
          <button 
            type="button" 
            class="theme-toggle-switch" 
            role="switch" 
            aria-checked="false" 
            aria-label="Toggle light and dark mode"
            title="Toggle between dark and light mode"
          >
            <span class="theme-switch-track">
              <span class="theme-icon sun" aria-hidden="true"><i class="fas fa-sun"></i></span>
              <span class="theme-icon moon" aria-hidden="true"><i class="fas fa-moon"></i></span>
              <span class="theme-switch-thumb">
                <i class="fas fa-moon current-icon"></i>
              </span>
            </span>
          </button>
        </div>

        <% if (currentUser) { 
          const rawMobileName = (currentUser.fullname || 'User').trim();
          const mobileNameWithoutTitle = rawMobileName.replace(/^dr\.?\s+/i, '').trim();
          const mobileInitial = (mobileNameWithoutTitle[0] || rawMobileName[0] || 'U').toUpperCase();
        %>
          <div class="mobile-user-info">
            <div class="user-avatar-badge <%= currentUser.role %>">
              <%= mobileInitial %>
            </div>
            <div>
              <strong><%= currentUser.fullname || 'User' %></strong>
              <small class="role-subtext"><%= (currentUser.role || 'patient').toUpperCase() %></small>
            </div>
          </div>
          <a href="/logout" class="mobile-btn-logout">
            <i class="fas fa-sign-out-alt"></i> Logout
          </a>
        <% } else { %>
          <a href="/login" class="nav-btn-secondary full-width">Sign In</a>
          <a href="/register" class="nav-btn-primary full-width">Register</a>
        <% } %>
      </div>
    </div>

    <div class="nav-actions-section">
      <!-- Dark / Light Theme Toggle Switch -->
      <button 
        type="button" 
        id="theme-toggle" 
        class="theme-toggle-switch" 
        role="switch" 
        aria-checked="false" 
        aria-label="Toggle light and dark mode"
        title="Toggle between dark and light mode"
      >
        <span class="theme-switch-track">
          <span class="theme-icon sun" aria-hidden="true"><i class="fas fa-sun"></i></span>
          <span class="theme-icon moon" aria-hidden="true"><i class="fas fa-moon"></i></span>
          <span class="theme-switch-thumb">
            <i class="fas fa-moon current-icon"></i>
          </span>
        </span>
      </button>

      <% if (currentUser) { 
        const rawName = (currentUser.fullname || 'User').trim();
        const nameWithoutTitle = rawName.replace(/^dr\.?\s+/i, '').trim();
        const userInitial = (nameWithoutTitle[0] || rawName[0] || 'U').toUpperCase();
        
        let displayName = rawName;
        if (currentUser.role === 'admin' && rawName.toLowerCase() === 'hospital administrator') {
          displayName = 'Hospital Admin';
        } else if (currentUser.role === 'receptionist') {
          displayName = rawName.replace(/\s*\(front\s*desk\)/i, '').trim();
        }
      %>
        <div class="user-profile-badge" title="<%= currentUser.fullname %>">
          <div class="user-avatar-circle <%= currentUser.role %>">
            <%= userInitial %>
          </div>
          <div class="user-meta-header">
            <span class="user-greeting">
              <strong><%= displayName %></strong>
            </span>
            <span class="role-pill-badge <%= currentUser.role %>">
              <%= currentUser.role.toUpperCase() %>
            </span>
          </div>
        </div>
        <a href="/logout" class="btn-nav-logout" title="Log Out">
          <i class="fas fa-sign-out-alt"></i>
          <span>Logout</span>
        </a>
      <% } else { %>
        <a href="/login" class="nav-btn-secondary">Sign In</a>
        <a href="/register" class="nav-btn-primary">
          <i class="fas fa-user-plus"></i> Register
        </a>
      <% } %>

      <button type="button" class="menu-toggle-btn" id="menu-toggle" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>
    </div>
  </nav>
  <div class="nav-backdrop" id="nav-backdrop"></div>
</header>