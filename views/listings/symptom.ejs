<% layout('/layouts/boilerplate.ejs') %>

<section class="symptom-wrapper">

    <div class="symptom-card">

        <h2 class="symptom-heading">
            Symptom Checker
        </h2>

        <p class="symptom-subtitle">
            Describe your symptoms and get basic health guidance.
        </p>

        <!-- Textarea -->

        <textarea
            class="symptom-input"
            placeholder="Enter your symptoms here..."
            disabled
        ></textarea>

        <!-- Button -->

        <button class="symptom-btn" disabled>
            Submit Symptoms
        </button>

        <!-- Under Construction Message -->

        <div class="construction-alert">

            ⚠ This feature is currently under construction.

            <br>

            We are working to bring you an intelligent symptom checker soon.

        </div>

    </div>

</section>