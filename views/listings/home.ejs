<% layout('/layouts/boilerplate.ejs') %>
    <section class="hero">
        <div class="hero-container">

            <div class="hero-text">

                <h1>Smart Healthcare System</h1>
                <p>
                    Book appointments easily and manage your
                    medical records online.
                </p>

                <div class="hero-buttons">

                    <a href="/appointment" class="btn-primary">
                        Book Appointment
                    </a>

                    <a href="/symptom" class="btn-secondary">
                        Check Symptoms
                    </a>

                </div>

            </div>

            <div class="hero-image">
                <img src="/images/doctor.png" alt="Doctors">
            </div>

        </div>
    </section>
    <section class="features">


        <h2 class="section-title">Why Choose Us?</h2>

        <div class="features-container">
            <div class="feature-card">

                <i class="fas fa-calendar-check feature-icon"></i>

                <h3>Easy Appointment Booking</h3>

                <p>
                    Schedule doctor visits in just a few clicks.
                </p>

            </div>
            <div class="feature-card">

                <i class="fas fa-file-medical feature-icon"></i>

                <h3>View Medical Reports</h3>

                <p>
                    Access your health records securely online.
                </p>

            </div>
            <div class="feature-card">

                <i class="fas fa-stethoscope feature-icon"></i>

                <h3>Symptom Checker</h3>

                <p>
                    Check your symptoms and find related diseases.
                </p>

            </div>

        </div>

    </section>