<% layout('/layouts/boilerplate.ejs') %>

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-container">
        <div class="hero-content">
            <div class="project-pill">
                <span class="live-dot"></span>
                <i class="fas fa-hospital"></i> Multi-Specialty Hospital & Medical Center
            </div>

            <h1 class="hero-title">
                Excellence in Healthcare & <br>
                <span class="neon-text">Specialist Consultation</span>
            </h1>

            <p class="hero-subtitle">
                Connecting patients with board-certified physicians and specialized medical faculties. Schedule clinical appointments, consult experienced doctors, and access modern healthcare services.
            </p>

            <div class="hero-cta-group">
                <% if (currentUser) { %>
                    <% if (currentUser.role === 'admin') { %>
                        <a href="/admin" class="btn-glow-cyan">
                            <i class="fas fa-shield-alt"></i> Admin Console
                        </a>
                    <% } else if (currentUser.role === 'doctor' || currentUser.role === 'receptionist') { %>
                        <a href="/staff" class="btn-glow-cyan">
                            <i class="fas <%= currentUser.role === 'doctor' ? 'fa-user-md' : 'fa-id-badge' %>"></i> <%= currentUser.role === 'doctor' ? 'Doctor Console' : 'Staff Console' %>
                        </a>
                    <% } else { %>
                        <a href="/dashboard" class="btn-glow-cyan">
                            <i class="fas fa-th-large"></i> Patient Dashboard
                        </a>
                    <% } %>
                <% } else { %>
                    <a href="/login" class="btn-glow-cyan">
                        <i class="fas fa-calendar-check"></i> Book Consultation
                    </a>
                <% } %>

                <a href="/doctors" class="btn-dark-glass">
                    <i class="fas fa-user-md"></i> Doctor Directory
                </a>
                <a href="/doctor/apply" class="btn-dark-outline">
                    <i class="fas fa-user-md text-cyan"></i> Join as Doctor
                </a>
            </div>

            <!-- Public Clinical Highlights Strip -->
            <div class="quick-stats-bar">
                <div class="quick-stat-item">
                    <i class="fas fa-user-md text-cyan"></i>
                    <div>
                        <strong>Expert Doctors</strong>
                        <small>Senior consultants</small>
                    </div>
                </div>
                <div class="stat-divider"></div>
                <div class="quick-stat-item">
                    <i class="fas fa-clinic-medical text-blue"></i>
                    <div>
                        <strong>8 Departments</strong>
                        <small>Specialized clinical care</small>
                    </div>
                </div>
                <div class="stat-divider"></div>
                <div class="quick-stat-item">
                    <i class="fas fa-heartbeat text-emerald"></i>
                    <div>
                        <strong>24/7 Emergency</strong>
                        <small>On-call medical duty</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-image-wrapper">
                <div class="dark-glow-circle"></div>
                <img src="/images/doctor.png" alt="CareSync Clinical Faculty" class="hero-doctor-img">

                <!-- Floating Clinical Badges -->
                <div class="dark-float-badge badge-pos-top">
                    <div class="badge-icon-box bg-cyan-glow">
                        <i class="fas fa-award"></i>
                    </div>
                    <div>
                        <strong>Board-Certified Specialists</strong>
                        <small><span class="pulse-emerald"></span> Verified Faculty</small>
                    </div>
                </div>

                <div class="dark-float-badge badge-pos-bottom-right">
                    <div class="badge-icon-box bg-blue-glow">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div>
                        <strong>Flexible Clinic Hours</strong>
                        <small>Morning & Evening Slots</small>
                    </div>
                </div>

                <div class="dark-float-badge badge-pos-bottom-left">
                    <div class="badge-icon-box bg-emerald-glow">
                        <i class="fas fa-shield-heart"></i>
                    </div>
                    <div>
                        <strong>Patient-Centered Care</strong>
                        <small>Comprehensive Diagnostics</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ENHANCED HOSPITAL DEPARTMENTS & SPECIALISTS SECTION -->
<section class="departments-showcase-section" id="departments-section">
    <div class="section-container">
        <div class="section-header-center">
            <span class="dark-section-tag"><i class="fas fa-hospital-alt"></i> Clinical Faculties</span>
            <h2 class="section-heading">Hospital Departments & Medical Specialties</h2>
            <p class="section-subheading">
                Explore our specialized medical divisions staffed by experienced physicians, equipped with state-of-the-art diagnostic facilities.
            </p>
        </div>

        <div class="departments-cards-grid">
            <!-- 1. Cardiology -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-cyan-glow">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <span class="dept-status-pill">Active Outpatient</span>
                </div>
                <h3>Cardiology & Heart Health</h3>
                <p>
                    Comprehensive cardiovascular evaluations including resting ECG, ambulatory blood pressure monitoring, heart failure management, and preventive cardiology.
                </p>
                <div class="dept-specialist-info">
                    <div class="spec-avatar bg-blue">RS</div>
                    <div>
                        <strong>Dr. Rajesh Sharma</strong>
                        <small>Senior Cardiologist • Mon-Fri (10 AM - 2 PM)</small>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <a href="/doctors" class="dept-link">
                        Consult Department <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Dermatology -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-purple-glow">
                        <i class="fas fa-allergies"></i>
                    </div>
                    <span class="dept-status-pill">Active Outpatient</span>
                </div>
                <h3>Dermatology & Skin Wellness</h3>
                <p>
                    Specialized diagnosis and treatment of complex dermatological conditions, allergic skin disorders, acne clinics, and trichology (hair health).
                </p>
                <div class="dept-specialist-info">
                    <div class="spec-avatar bg-purple">PM</div>
                    <div>
                        <strong>Dr. Priya Mehta</strong>
                        <small>Chief Dermatologist • Tue-Sat (12 PM - 4 PM)</small>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <a href="/doctors" class="dept-link">
                        Consult Department <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 3. General Medicine -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-blue-glow">
                        <i class="fas fa-stethoscope"></i>
                    </div>
                    <span class="dept-status-pill">Primary Care</span>
                </div>
                <h3>General Medicine & Internal Care</h3>
                <p>
                    Primary medical evaluations for acute fevers, metabolic and endocrine disorders, respiratory infections, hypertension, and long-term wellness management.
                </p>
                <div class="dept-specialist-info">
                    <div class="spec-avatar bg-cyan">AV</div>
                    <div>
                        <strong>Dr. Amit Verma</strong>
                        <small>General Physician • Mon-Thu (9 AM - 1 PM)</small>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <a href="/doctors" class="dept-link">
                        Consult Department <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 4. Pediatrics -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-emerald-glow">
                        <i class="fas fa-baby"></i>
                    </div>
                    <span class="dept-status-pill">Child Care</span>
                </div>
                <h3>Pediatrics & Child Wellness</h3>
                <p>
                    Specialized infant and adolescent healthcare covering developmental milestones, vaccination schedules, pediatric infectious diseases, and pediatric nutrition.
                </p>
                <div class="dept-specialist-info">
                    <div class="spec-avatar bg-emerald">NK</div>
                    <div>
                        <strong>Dr. Neha Kapoor</strong>
                        <small>Pediatric Consultant • Mon-Fri (11 AM - 3 PM)</small>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <a href="/doctors" class="dept-link">
                        Consult Department <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 5. Neurology -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-blue-glow">
                        <i class="fas fa-brain"></i>
                    </div>
                    <span class="dept-status-pill">Specialized</span>
                </div>
                <h3>Neurology & Brain Sciences</h3>
                <p>
                    Comprehensive neurological consultations for chronic migraines, peripheral neuropathies, epilepsy management, sleep disturbances, and motor nerve assessments.
                </p>
                <div class="dept-specialist-info">
                    <div class="spec-avatar bg-blue">RS</div>
                    <div>
                        <strong>Dr. Rahul Singh</strong>
                        <small>Neurologist • Wed-Sun (2 PM - 6 PM)</small>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <a href="/doctors" class="dept-link">
                        Consult Department <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- 6. Gynecology -->
            <div class="dept-card-dark">
                <div class="dept-card-header">
                    <div class="dept-icon-box bg-purple-glow">
