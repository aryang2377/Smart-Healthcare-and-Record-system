<% layout('/layouts/boilerplate.ejs') %>

<section class="rx-slip-wrapper">
    <div class="rx-slip-container">
        <!-- Action Bar (hidden on print) -->
        <div class="rx-action-bar no-print">
            <a href="javascript:history.back()" class="btn-rx-back">
                <i class="fas fa-arrow-left"></i> Back to Dashboard
            </a>
            <div class="rx-action-group">
                <button type="button" class="btn-rx-print" onclick="window.print()">
                    <i class="fas fa-print"></i> Print Prescription / Save PDF
                </button>
            </div>
        </div>

        <!-- Official Prescription Slip Card -->
        <div class="rx-paper-card" id="printableRx">
            <!-- Header -->
            <div class="rx-clinic-header">
                <div class="rx-brand-info">
                    <div class="rx-clinic-logo">
                        <img src="/images/logo.png" alt="CareSync" style="height: 38px;">
                    </div>
                    <div>
                        <h2>CareSync Multispecialty Hospital</h2>
                        <p>Department of Clinical Medicine • Outpatient Consultation Services</p>
                        <small>CareSync Tower, Sector 62, Medical District • Helpline: +91 (800) 227-3796</small>
                    </div>
                </div>
                <div class="rx-badge-box">
                    <span class="rx-badge-pill">OFFICIAL DIGITAL Rx</span>
                    <strong class="rx-id-text"><%= rx.rxNumber %></strong>
                    <small>Date: <%= new Date(rx.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
                </div>
            </div>

            <div class="rx-divider-solid"></div>

            <!-- Doctor & Patient Details Grid -->
            <div class="rx-parties-grid">
                <!-- Doctor block -->
                <div class="rx-doc-block">
                    <span class="rx-section-label">ATTENDING PHYSICIAN</span>
                    <h3><%= rx.doctorName %></h3>
                    <p class="rx-spec-text"><i class="fas fa-stethoscope"></i> <%= rx.doctorSpecialization %></p>
                    <small class="rx-meta-sub">Institutional Medical Faculty • CareSync Hospital</small>
                </div>

                <!-- Patient block -->
                <div class="rx-pat-block">
                    <span class="rx-section-label">PATIENT DETAILS</span>
                    <h3><%= rx.patientName %></h3>
                    <div class="rx-pat-meta">
                        <% if (rx.patientAge) { %>
                            <span>Age: <strong><%= rx.patientAge %> yrs</strong></span> •
                        <% } %>
                        <% if (rx.patientGender) { %>
                            <span>Gender: <strong><%= rx.patientGender %></strong></span> •
                        <% } %>
                        <span>Status: <strong class="text-emerald">Consulted</strong></span>
                    </div>
                    <% if (rx.patientEmail) { %>
                        <small class="rx-meta-sub">Patient ID: <%= rx.patientEmail %></small>
                    <% } %>
                </div>
            </div>

            <div class="rx-divider-dotted"></div>

            <!-- Problem / Chief Complaints -->
            <div class="rx-clinical-section">
                <div class="rx-field-row">
                    <span class="rx-label-tag"><i class="fas fa-comment-medical"></i> Patient's Reported Problem / Symptoms:</span>
                    <div class="rx-content-box problem-box">
                        <%= rx.problem %>
                    </div>
                </div>

                <div class="rx-field-row" style="margin-top: 14px;">
                    <span class="rx-label-tag"><i class="fas fa-stethoscope"></i> Clinical Diagnosis & Findings:</span>
                    <div class="rx-content-box diagnosis-box">
                        <strong><%= rx.diagnosis %></strong>
                    </div>
                </div>
            </div>

            <!-- Rx Symbol & Medications -->
            <div class="rx-medications-section">
                <div class="rx-symbol-heading">
                    <span class="rx-big-symbol">℞</span>
                    <h4>Prescribed Medications & Regimen</h4>
                </div>

                <div class="rx-meds-box">
                    <pre class="rx-meds-pre"><%= rx.medicines %></pre>
                </div>
            </div>

            <!-- Advice & Tests -->
            <% if (rx.advice || rx.testsRecommended) { %>
                <div class="rx-advice-grid">
                    <% if (rx.advice) { %>
                        <div class="rx-advice-item">
                            <span class="rx-advice-title"><i class="fas fa-heartbeat text-cyan"></i> Diet & Lifestyle Advice:</span>
                            <p><%= rx.advice %></p>
                        </div>
                    <% } %>

                    <% if (rx.testsRecommended) { %>
                        <div class="rx-advice-item">
                            <span class="rx-advice-title"><i class="fas fa-vial text-emerald"></i> Diagnostic Tests Advised:</span>
                            <p><%= rx.testsRecommended %></p>
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Follow-up -->
            <div class="rx-followup-bar">
                <div>
                    <i class="fas fa-calendar-alt text-cyan"></i>
                    <span>Next Review / Follow-up: <strong><%= rx.followUp || 'As needed' %></strong></span>
                </div>
                <div class="rx-status-tag">
                    <i class="fas fa-check-circle"></i> <%= rx.status %>
                </div>
            </div>

            <!-- Footer Signatures -->
            <div class="rx-slip-footer">
                <div class="rx-qr-placeholder">
                    <i class="fas fa-shield-alt text-cyan" style="font-size: 28px;"></i>
                    <div>
                        <strong>Verified Digital Record</strong>
                        <small>CareSync Health EHR Network</small>
                    </div>
                </div>

                <div class="rx-sign-block">
                    <div class="rx-sign-line"></div>
                    <strong><%= rx.doctorName %></strong>
                    <small><%= rx.doctorSpecialization %></small>
                    <span class="rx-sign-badge">Digitally Authorized</span>
                </div>
            </div>

            <div class="rx-legal-disclaimer">
                This digital prescription was authorized and issued electronically by the attending physician following clinical consultation.
            </div>
        </div>
    </div>
</section>

<style>
.rx-slip-wrapper {
    padding: 30px 20px 60px;
    background: #060913;
    min-height: calc(100vh - 120px);
}
.rx-slip-container {
    max-width: 820px;
    margin: 0 auto;
}
.rx-action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.btn-rx-back {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s;
}
.btn-rx-back:hover {
    color: #38bdf8;
}
.btn-rx-print {
    background: linear-gradient(135deg, #0284c7, #0369a1);
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.3);
    transition: all 0.2s;
}
.btn-rx-print:hover {
    background: linear-gradient(135deg, #0369a1, #075985);
    transform: translateY(-1px);
}
.rx-paper-card {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 14px;
    padding: 36px 40px;
    box-shadow: 0 12px 36px rgba(0,0,0,0.4);
    color: #f1f5f9;
}
.rx-clinic-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
}
.rx-brand-info {
    display: flex;
    gap: 16px;
    align-items: flex-start;
}
.rx-brand-info h2 {
    font-size: 20px;
    font-weight: 800;
    color: #f8fafc;
    margin: 0 0 4px;
}
.rx-brand-info p {
    font-size: 13px;
    color: #38bdf8;
    margin: 0 0 4px;
    font-weight: 600;
}
.rx-brand-info small {
    font-size: 11.5px;
    color: #64748b;
}
.rx-badge-box {
    text-align: right;
}
.rx-badge-pill {
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 20px;
    display: inline-block;
}
.rx-id-text {
    display: block;
    font-size: 16px;
    font-weight: 800;
    color: #f8fafc;
    margin: 6px 0 2px;
}
.rx-badge-box small {
    color: #94a3b8;
    font-size: 12px;
}
.rx-divider-solid {
    height: 2px;
    background: linear-gradient(90deg, #0284c7, #38bdf8, #10b981);
    margin: 22px 0;
    border-radius: 2px;
}
.rx-parties-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}
.rx-section-label {
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.7px;
    color: #64748b;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
}
.rx-doc-block h3, .rx-pat-block h3 {
    font-size: 17px;
    font-weight: 800;
    margin: 0 0 4px;
    color: #f8fafc;
}
.rx-spec-text {
    font-size: 13px;
    color: #38bdf8;
    margin: 0 0 4px;
    font-weight: 600;
}
.rx-meta-sub {
    font-size: 12px;
    color: #94a3b8;
}
.rx-pat-meta {
    font-size: 13px;
    color: #cbd5e1;
    margin-bottom: 4px;
}
.rx-divider-dotted {
    border-bottom: 1px dashed #334155;
    margin: 20px 0;
}
.rx-clinical-section {
    margin-bottom: 22px;
}
.rx-field-row {
    margin-bottom: 12px;
}
.rx-label-tag {
    font-size: 12.5px;
    font-weight: 700;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
}
.rx-content-box {
    background: #0a0f1d;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 13.5px;
    color: #e2e8f0;
    line-height: 1.5;
}
.rx-content-box.diagnosis-box {
    border-left: 3px solid #38bdf8;
}
.rx-medications-section {
    background: #080d1a;
    border: 1px solid #1e293b;
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 20px;
}
.rx-symbol-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 10px;
}
.rx-big-symbol {
    font-size: 32px;
    font-family: serif;
    font-weight: 900;
    color: #38bdf8;
    line-height: 1;
}
.rx-symbol-heading h4 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: #f8fafc;
}
.rx-meds-box {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 14px 18px;
}
.rx-meds-pre {
    margin: 0;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13.5px;
    line-height: 1.7;
    color: #f1f5f9;
    white-space: pre-wrap;
    word-break: break-word;
}
.rx-advice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
}
.rx-advice-item {
    background: #0a0f1d;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 12px 16px;
}
.rx-advice-title {
    font-size: 12px;
    font-weight: 700;
    color: #cbd5e1;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
}
.rx-advice-item p {
    margin: 0;
    font-size: 13px;
    color: #94a3b8;
    line-height: 1.45;
}
.rx-followup-bar {
    background: rgba(56, 189, 248, 0.05);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 8px;
    padding: 12px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    margin-bottom: 28px;
}
.rx-status-tag {
    color: #34d399;
    font-weight: 700;
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
}
.rx-slip-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 18px;
    border-top: 1px solid #1e293b;
    margin-bottom: 16px;
}
.rx-qr-placeholder {
    display: flex;
    align-items: center;
    gap: 12px;
}
.rx-qr-placeholder strong {
    display: block;
    font-size: 12px;
    color: #e2e8f0;
}
.rx-qr-placeholder small {
    font-size: 11px;
    color: #64748b;
}
.rx-sign-block {
    text-align: right;
}
.rx-sign-line {
    width: 160px;
    height: 1px;
    background: #475569;
    margin-bottom: 6px;
    margin-left: auto;
}
.rx-sign-block strong {
    display: block;
    font-size: 14px;
    color: #f8fafc;
}
.rx-sign-block small {
    display: block;
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 4px;
}
.rx-sign-badge {
    font-size: 10px;
    color: #34d399;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.3);
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 700;
}
.rx-legal-disclaimer {
    font-size: 11px;
    color: #475569;
    text-align: center;
    margin-top: 12px;
}

@media print {
    body {
        background: #fff !important;
        color: #000 !important;
    }
    .navbar-wrapper, .dark-footer, .no-print {
        display: none !important;
    }
    .rx-slip-wrapper {
        background: #fff !important;
        padding: 0 !important;
    }
    .rx-paper-card {
        background: #fff !important;
        color: #000 !important;
        border: 1px solid #ccc !important;
        box-shadow: none !important;
        padding: 20px !important;
    }
    .rx-brand-info h2, .rx-doc-block h3, .rx-pat-block h3, .rx-id-text, .rx-sign-block strong {
        color: #000 !important;
    }
    .rx-brand-info p, .rx-spec-text, .rx-big-symbol {
        color: #0284c7 !important;
    }
    .rx-content-box, .rx-meds-box, .rx-advice-item {
        background: #f8fafc !important;
        border: 1px solid #cbd5e1 !important;
        color: #0f172a !important;
    }
    .rx-meds-pre {
        color: #0f172a !important;
    }
    .rx-followup-bar {
        background: #f1f5f9 !important;
        color: #0f172a !important;
        border: 1px solid #cbd5e1 !important;
    }
}
</style>
