<% layout('/layouts/boilerplate.ejs') %>

<section class="find-doctors">

    <div class="page-header">
        <h2>Available Doctors</h2>
        <p>Search doctors, check availability, and book appointments instantly</p>
    </div>

    <div class="stats-container">

        <div class="stat-card">
            <div class="stat-number">10</div>
            <div class="stat-label">Total Doctors</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">7</div>
            <div class="stat-label">Available Today</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">8</div>
            <div class="stat-label">Specializations</div>
        </div>

        <div class="stat-card">
            <div class="stat-number">24</div>
            <div class="stat-label">Appointments</div>
        </div>

    </div>

    <div class="controls">

        <input 
            type="text" 
            placeholder="Search doctor..."
            class="search-box"
        >

        <select class="filter-box">
            <option>All Specializations</option>
            <option>Cardiologist</option>
            <option>Dermatologist</option>
            <option>General Physician</option>
            <option>Pediatrician</option>
            <option>Neurologist</option>
            <option>Gynecologist</option>
            <option>ENT Specialist</option>
            <option>Dentist</option>
        </select>

    </div>

    <div class="doctor-card">

        <table class="doctor-table">

            <thead>
                <tr>
                    <th>Doctor Name</th>
                    <th>Specialization</th>
                    <th>Available Days</th>
                    <th>Timing</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>Dr. Rajesh Sharma</td>
                    <td>Cardiologist</td>
                    <td>Mon - Fri</td>
                    <td>10 AM - 2 PM</td>
                    <td>
                        <button class="book-btn">
                            Book
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Priya Mehta</td>
                    <td>Dermatologist</td>
                    <td>Tue - Sat</td>
                    <td>12 PM - 4 PM</td>
                    <td>
                        <button class="book-btn">
                            Book
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Amit Verma</td>
                    <td>General Physician</td>
                    <td>Mon - Thu</td>
                    <td>9 AM - 1 PM</td>
                    <td>
                        <button class="book-btn">
                            Book
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Neha Kapoor</td>
                    <td>Pediatrician</td>
                    <td>Mon - Fri</td>
                    <td>11 AM - 3 PM</td>
                    <td>
                        <button class="book-btn">
                            Book
                        </button>
                    </td>
                </tr>

                <tr>
                    <td>Dr. Rahul Singh</td>
                    <td>Neurologist</td>
                    <td>Wed - Sun</td>
                    <td>2 PM - 6 PM</td>
                    <td>
                        <button class="book-btn">
                            Book
                        </button>
                    </td>
                </tr>

            </tbody>

        </table>

    </div>

</section>