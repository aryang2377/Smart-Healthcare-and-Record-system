<% layout('/layouts/boilerplate.ejs') %>

    <section class="dashboard" role="main">

        <div class="dashboard-header">
            <div>
                <h2>
                    Welcome,
                    <%= currentUser ? currentUser.fullname || "User" : "User" %>!
                </h2>
                <p>Your health overview for today</p>
            </div>
        </div>

        <div class="summary-row">

            <div class="summary-card blue">
                <span>Next Appointment</span>

                <h3>
                    <% if (nextAppointment) { %>
                        <%= new Date(nextAppointment.date).toLocaleDateString() %>
                            <%= nextAppointment.time %>
                                <% } else { %>
                                    No upcoming appointment
                                    <% } %>
                </h3>
            </div>

            <div class="summary-card purple">
                <span>Total Appointments</span>

                <h3>
                    <%= totalAppointments %>
                </h3>
            </div>

            <div class="summary-card green">
                <span>Last Visit</span>

                <h3>
                    <% if (lastVisit) { %>
                        <%= new Date(lastVisit.date).toLocaleDateString() %>
                            <% } else { %>
                                No visits yet
                                <% } %>
                </h3>
            </div>

        </div>

        <div class="main-grid">

            <div class="card">

                <h3>Book Appointment</h3>

                <form action="/appointments" method="POST">

                    <label>Your Name</label>

                    <input type="text" name="patientName" value="<%= currentUser ? currentUser.fullname : '' %>"
                        required>

                    <div class="row">

                        <div>
                            <label>Age</label>

                            <input type="number" name="age" min="0" max="120" required>
                        </div>

                        <div>
                            <label>Gender</label>

                            <select name="gender" required>
                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>
                            </select>
                        </div>

                    </div>

                    <div class="row">

                        <div>
                            <label>Date</label>

                            <input type="date" name="date" required>
                        </div>

                        <div>
                            <label>Time</label>

                            <input type="time" name="time" required>
                        </div>

                    </div>

                    <label>Select Doctor</label>

                    <select name="doctorName" required>
                        <option>
                            Dr. Rajesh Sharma
                        </option>

                        <option>
                            Dr. Priya Mehta
                        </option>

                        <option>
                            Dr. Amit Verma
                        </option>
                    </select>

                    <button type="submit" class="primary-btn">
                        Confirm Appointment
                    </button>

                </form>

                <div class="reminder-box">
                    Upcoming Checkup Reminder
                    <strong>
                        Dental Cleaning — Next Week
                    </strong>
                </div>

                <div class="quick-actions">

                    <a href="/doctors" class="quick-card">
                        Find Doctors
                    </a>

                    <div class="quick-card">
                        Medical Records
                    </div>

                    <div class="quick-card">
                        Download Reports
                    </div>

                </div>

            </div>

            <div class="card">

                <h3>Today's Schedule</h3>

                <% if (todaysSchedule.length> 0) { %>

                    <% todaysSchedule.forEach(function(appt){ %>

                        <div class="appointment-card">

                            <div class="avatar">
                                <%= appt.doctorName.substring(0,2).toUpperCase() %>
                            </div>

                            <div>

                                <strong>
                                    <%= appt.doctorName %>
                                </strong>

                                <p>
                                    <%= appt.time %>
                                </p>

                            </div>

                            <span class="status scheduled">
                                <%= appt.status %>
                            </span>

                        </div>

                        <% }) %>

                            <% } else { %>

                                <p>
                                    No appointments today
                                </p>

                                <% } %>

            </div>

        </div>

        <div class="card">

            <h3>Recent Activity</h3>

            <div class="activity-item">
                Appointment booked successfully
            </div>

            <div class="activity-item">
                Dashboard updated from database
            </div>

            <div class="activity-item">
                User logged in securely
            </div>

        </div>

    </section>