<% layout('/layouts/boilerplate.ejs') %>

<section class="dashboard-wrapper-dark">
    <div class="dashboard-container">
        <!-- Admin Header -->
        <div class="dash-header-dark">
            <div class="dash-user-info">
                <div class="user-large-avatar admin-avatar">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <div>
                    <h2><%= currentUser.fullname %></h2>
                    <p>
                        <span class="role-pill-badge admin">HOSPITAL SYSTEM ADMINISTRATOR</span>
                        <span class="doc-email-text">• <%= currentUser.email %></span>
                        <span style="color: #34d399; font-size: 12px; margin-left: 8px;"><i class="fas fa-circle" style="font-size: 8px;"></i> System Live</span>
                    </p>
                </div>
            </div>
            <div class="dash-quick-cta">
                <button type="button" class="btn-book-quick" onclick="switchTab('staff')">
                    <i class="fas fa-user-plus"></i> Invite / Add Staff
                </button>
            </div>
        </div>

        <!-- Metric Cards -->
        <div class="metrics-row-dark">
            <div class="metric-card-dark">
                <div class="metric-icon bg-cyan-glow">
                    <i class="fas fa-users"></i>
                </div>
                <div>
                    <h3><%= totalPatients %></h3>
                    <span>Total Patients</span>
                </div>
            </div>

            <div class="metric-card-dark">
                <div class="metric-icon bg-emerald-glow">
                    <i class="fas fa-user-md"></i>
                </div>
                <div>
                    <h3><%= totalDoctors %></h3>
                    <span>Verified Doctors</span>
                </div>
            </div>

            <div class="metric-card-dark">
                <div class="metric-icon bg-blue-glow">
                    <i class="fas fa-id-badge"></i>
                </div>
                <div>
                    <h3><%= typeof totalReceptionists !== 'undefined' ? totalReceptionists : 1 %></h3>
                    <span>Front Desk Staff</span>
                </div>
            </div>

            <div class="metric-card-dark">
                <div class="metric-icon bg-purple-glow">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <div>
                    <h3><%= totalAppointments %></h3>
                    <span>Total Appointments</span>
                </div>
            </div>
        </div>

        <!-- Tab Navigation Bar -->
        <div class="dash-tabs-bar" style="overflow-x: auto; flex-wrap: nowrap;">
            <button type="button" class="dash-tab-btn <%= activeTab === 'overview' ? 'active' : '' %>" onclick="switchTab('overview')">
                <i class="fas fa-chart-pie"></i> Overview & Analytics
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'verification' ? 'active' : '' %>" onclick="switchTab('verification')">
                <i class="fas fa-user-check text-cyan"></i> Doctor Verification (<%= (typeof pendingDoctors !== 'undefined' ? pendingDoctors.length : 0) %>)
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'staff' ? 'active' : '' %>" onclick="switchTab('staff')">
                <i class="fas fa-user-doctor"></i> Staff Management (<%= (typeof doctorsList !== 'undefined' ? doctorsList.length : 0) + (typeof receptionistsList !== 'undefined' ? receptionistsList.length : 0) %>)
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'patients' ? 'active' : '' %>" onclick="switchTab('patients')">
                <i class="fas fa-hospital-user"></i> Patient Directory (<%= patientsList.length %>)
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'appointments' ? 'active' : '' %>" onclick="switchTab('appointments')">
                <i class="fas fa-calendar-alt"></i> Master Appointments
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'audit' ? 'active' : '' %>" onclick="switchTab('audit')">
                <i class="fas fa-history text-purple"></i> Audit Logs
            </button>
            <button type="button" class="dash-tab-btn <%= activeTab === 'triage' ? 'active' : '' %>" onclick="switchTab('triage')">
                <i class="fas fa-robot text-cyan"></i> AI Symptom Triage (<%= typeof allTriageLogs !== 'undefined' ? allTriageLogs.length : 0 %>)
            </button>
        </div>

        <!-- TAB 1: OVERVIEW & ANALYTICS -->
        <div id="tab-overview" class="tab-pane-dark" style="<%= activeTab === 'overview' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-grid-split">
                <div class="dash-card-dark">
                    <div class="card-head">
                        <h3><i class="fas fa-hospital text-cyan"></i> Hospital Operations Status</h3>
                        <small>Key system and clinical performance indicators</small>
                    </div>

                    <div class="status-summary-grid">
                        <div class="status-summary-box">
                            <span class="box-lbl">System Uptime</span>
                            <strong style="color: #34d399;">99.98%</strong>
                            <small class="text-emerald"><i class="fas fa-check-circle"></i> Operational</small>
                        </div>
                        <div class="status-summary-box">
                            <span class="box-lbl">Verified Specialists</span>
                            <strong style="color: #38bdf8;"><%= totalDoctors %> Doctors</strong>
                            <small class="text-cyan">Credentialed & Active</small>
                        </div>
                        <div class="status-summary-box">
                            <span class="box-lbl">EHR Security & Confidentiality</span>
                            <strong style="color: #c084fc;">Role-Enforced</strong>
                            <small class="text-purple">Doctor/Patient Scoped</small>
                        </div>
                    </div>

                    <div class="recent-audit-log" style="margin-top: 20px;">
                        <h4><i class="fas fa-clipboard-list text-blue"></i> Recent Master Appointments</h4>
                        <% if (masterAppointments.length > 0) { %>
                            <div class="table-scroll-wrap">
                                <table class="dash-table-dark">
                                    <thead>
                                        <tr>
                                            <th>Patient</th>
                                            <th>Doctor</th>
                                            <th>Date & Time</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% masterAppointments.slice(0, 5).forEach(appt => { %>
                                            <tr>
                                                <td><strong><%= appt.patientName %></strong></td>
                                                <td><%= appt.doctorName %></td>
                                                <td><%= new Date(appt.date).toLocaleDateString() %> <small class="text-dim"><%= appt.time %></small></td>
                                                <td>
                                                    <span class="status-pill <%= appt.status.toLowerCase().replace(/[^a-z]/g, '') %>">
                                                        <%= appt.status %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <div class="empty-state-box">
                                <i class="fas fa-calendar-times"></i>
                                <p>No appointments recorded yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="dash-card-dark">
                    <div class="card-head">
                        <h3><i class="fas fa-sliders-h text-emerald"></i> Quick System Controls</h3>
                        <small>Manage medical teams, review applications, and audit logs</small>
                    </div>
                    <div class="quick-admin-actions">
                        <button type="button" class="btn-admin-action" onclick="switchTab('verification')">
                            <i class="fas fa-user-check text-cyan"></i>
                            <div>
                                <strong>Doctor Verification Desk</strong>
                                <span><%= (typeof pendingDoctors !== 'undefined' ? pendingDoctors.length : 0) %> pending applications</span>
                            </div>
                        </button>
                        <button type="button" class="btn-admin-action" onclick="switchTab('staff')">
                            <i class="fas fa-user-plus text-emerald"></i>
                            <div>
                                <strong>Staff Management</strong>
                                <span>Add doctor or front-desk receptionist</span>
                            </div>
                        </button>
                        <button type="button" class="btn-admin-action" onclick="switchTab('appointments')">
                            <i class="fas fa-calendar-check text-blue"></i>
                            <div>
                                <strong>Master Appointments</strong>
                                <span>Review all clinical bookings</span>
                            </div>
                        </button>
                        <button type="button" class="btn-admin-action" onclick="switchTab('audit')">
                            <i class="fas fa-history text-purple"></i>
                            <div>
                                <strong>Security & Audit Trail</strong>
                                <span>Inspect platform events and actions</span>
                            </div>
                        </button>
                    </div>

                    <!-- Clinical Data Privacy Statement -->
                    <div class="privacy-notice-box" style="margin-top: 22px; padding: 14px; border-radius: 8px;">
                        <div class="privacy-notice-title" style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
                            <i class="fas fa-shield-halved text-cyan"></i> Medical Privacy Notice
                        </div>
                        <p class="privacy-notice-text" style="font-size: 12px; margin: 0; line-height: 1.5;">
                            Administration permissions are restricted to platform operations, credential validation, and facility logistics. Unrestricted access to private consultation notes and confidential medical records is strictly separated.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DOCTOR VERIFICATION DESK -->
        <div id="tab-verification" class="tab-pane-dark" style="<%= activeTab === 'verification' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-card-dark">
                <div class="card-head">
                    <h3><i class="fas fa-user-check text-cyan"></i> Doctor Credential Verification Desk</h3>
                    <small>Review submitted medical licenses, qualifications, and onboarding details</small>
                </div>

                <% if (typeof pendingDoctors !== 'undefined' && pendingDoctors.length > 0) { %>
                    <div style="display: flex; flex-direction: column; gap: 18px; margin-top: 18px;">
                        <% pendingDoctors.forEach(doc => { %>
                            <div class="doc-verification-card" style="border-radius: 12px; padding: 22px;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 12px; margin-bottom: 14px;">
                                    <div>
                                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                            <h4 class="doc-card-title" style="font-size: 17px; font-weight: 700; margin: 0;"><%= doc.fullname %></h4>
                                            <span class="dept-badge cyan"><%= doc.specialization %></span>
                                            <% if (doc.approvalStatus === 'needs_info') { %>
                                                <span style="font-size: 11px; font-weight: 700; color: #38bdf8; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); padding: 2px 8px; border-radius: 12px;">
                                                    INFO REQUESTED
                                                </span>
                                            <% } else { %>
                                                <span style="font-size: 11px; font-weight: 700; color: #fbbf24; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); padding: 2px 8px; border-radius: 12px;">
                                                    PENDING REVIEW
                                                </span>
                                            <% } %>
                                        </div>
                                        <small style="color: #94a3b8; display: block; margin-top: 4px;">
                                            <%= doc.email %> • <%= doc.phone || 'No phone' %> • Applied: <%= new Date(doc.createdAt).toLocaleDateString() %>
                                        </small>
                                        <% if (doc.adminNotes) { %>
                                            <div style="margin-top: 6px; font-size: 12px; color: #38bdf8; background: rgba(56, 189, 248, 0.08); padding: 4px 10px; border-radius: 4px; display: inline-block;">
                                                <strong>Admin Remark:</strong> <%= doc.adminNotes %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                        <!-- Approve -->
                                        <form action="/admin/doctors/<%= doc._id %>/approve" method="POST" style="margin: 0;">
                                            <button type="submit" class="auth-btn doctor-btn" style="width: auto; padding: 8px 16px; font-size: 13px;">
                                                <i class="fas fa-check-circle"></i> Approve & Activate
                                            </button>
                                        </form>

                                        <!-- Request Info -->
                                        <button type="button" class="auth-btn" style="width: auto; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #38bdf8; padding: 8px 16px; font-size: 13px;" onclick="openInfoModal('<%= doc._id %>', '<%= doc.fullname %>')">
                                            <i class="fas fa-question-circle"></i> Request Info
                                        </button>

                                        <!-- Reject -->
                                        <button type="button" class="auth-btn" style="width: auto; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 8px 16px; font-size: 13px;" onclick="openRejectModal('<%= doc._id %>', '<%= doc.fullname %>')">
                                            <i class="fas fa-times-circle"></i> Reject
                                        </button>
                                    </div>
                                </div>

                                <div class="doc-details-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; padding: 14px; border-radius: 8px; margin-bottom: 14px; font-size: 13px;">
                                    <div>
                                        <span style="color: #94a3b8; display: block;">Qualifications:</span>
                                        <strong class="doc-detail-val"><%= doc.qualifications || 'MBBS / MD' %></strong>
                                    </div>
                                    <div>
                                        <span style="color: #94a3b8; display: block;">Experience:</span>
                                        <strong class="doc-detail-val"><%= doc.experience || '0' %> Years</strong>
                                    </div>
                                    <div>
                                        <span style="color: #94a3b8; display: block;">License / Registration #:</span>
                                        <strong style="color: #38bdf8;"><%= doc.licenseNumber || 'MCI Pending' %></strong>
                                    </div>
                                    <div>
                                        <span style="color: #94a3b8; display: block;">Registration Authority:</span>
                                        <strong class="doc-detail-val"><%= doc.registrationAuthority || 'National Medical Commission' %></strong>
                                    </div>
                                    <div>
                                        <span style="color: #94a3b8; display: block;">Consultation Fee:</span>
                                        <strong style="color: #34d399;">₹<%= doc.consultationFee || 500 %></strong>
                                    </div>
                                    <div>
                                        <span style="color: #94a3b8; display: block;">Working Schedule:</span>
                                        <strong class="doc-detail-val"><%= doc.workingDays || 'Mon - Fri' %> (<%= doc.workingHours || '09:00 AM - 02:00 PM' %>)</strong>
                                    </div>
                                </div>

                                <div>
                                    <span style="font-size: 12px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 8px;">
                                        Uploaded Verification Documents:
                                    </span>
                                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                        <% if (doc.licenseDoc) { %>
                                            <a href="<%= doc.licenseDoc %>" target="_blank" class="btn-file-action" style="font-size: 12px; padding: 6px 12px;">
                                                <i class="fas fa-file-pdf text-cyan"></i> View License Document
                                            </a>
                                        <% } else { %>
                                            <span style="font-size: 12px; color: #64748b; background: rgba(255,255,255,0.03); padding: 4px 10px; border-radius: 4px;">License Document Pending</span>
                                        <% } %>

                                        <% if (doc.degreeDoc) { %>
                                            <a href="<%= doc.degreeDoc %>" target="_blank" class="btn-file-action" style="font-size: 12px; padding: 6px 12px;">
                                                <i class="fas fa-graduation-cap text-emerald"></i> View Degree Certificate
                                            </a>
                                        <% } %>

                                        <% if (doc.idDoc) { %>
                                            <a href="<%= doc.idDoc %>" target="_blank" class="btn-file-action" style="font-size: 12px; padding: 6px 12px;">
                                                <i class="fas fa-id-card text-purple"></i> View Government ID
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="empty-state-box" style="margin-top: 20px;">
                        <i class="fas fa-check-double text-emerald"></i>
                        <p>All submitted doctor applications have been processed. No pending verifications at this time.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB 3: STAFF MANAGEMENT (DOCTORS & RECEPTIONISTS) -->
        <div id="tab-staff" class="tab-pane-dark" style="<%= activeTab === 'staff' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-grid-split">
                <!-- Add Staff Form -->
                <div class="dash-card-dark">
                    <div class="card-head">
                        <h3><i class="fas fa-user-plus text-cyan"></i> Provision Staff Member</h3>
                        <small>Create doctor or front-desk receptionist account</small>
                    </div>

                    <form action="/admin/staff/add" method="POST" class="dash-form">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="fullname" placeholder="e.g. Dr. Rohan Saxena or Sarah Jenkins" required class="dark-dash-input">
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Institutional Email</label>
                                <input type="email" name="email" placeholder="e.g. staff@caresync.health" required class="dark-dash-input">
                            </div>
                            <div class="form-group">
                                <label>Staff Role</label>
                                <select name="role" required class="dark-dash-select">
                                    <option value="doctor">Medical Doctor</option>
                                    <option value="receptionist">Front Desk Receptionist</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Specialization / Desk</label>
                                <input type="text" name="specialization" placeholder="e.g. Cardiology, Outpatient Desk" required class="dark-dash-input">
                            </div>
                            <div class="form-group">
                                <label>Contact Phone</label>
                                <input type="text" name="phone" placeholder="e.g. +91 98765 00000" class="dark-dash-input">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Temporary Password</label>
                            <input type="password" name="password" placeholder="Create secure password (min 6 chars)" required class="dark-dash-input">
                        </div>

                        <button type="submit" class="btn-dash-primary">
                            <i class="fas fa-user-shield"></i> Provision Account
                        </button>
                    </form>
                </div>

                <!-- Active Staff Table -->
                <div class="dash-card-dark">
                    <div class="card-head">
                        <h3><i class="fas fa-user-doctor text-emerald"></i> Healthcare Staff Directory</h3>
                        <small>Active physicians, specialists, and front-desk personnel</small>
                    </div>

                    <% 
                        const allStaff = [...(typeof doctorsList !== 'undefined' ? doctorsList : []), ...(typeof receptionistsList !== 'undefined' ? receptionistsList : [])];
                    %>
                    <% if (allStaff.length > 0) { %>
                        <div class="table-scroll-wrap">
                            <table class="dash-table-dark">
                                <thead>
                                    <tr>
                                        <th>Name & Email</th>
                                        <th>Role</th>
                                        <th>Specialty / Unit</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% allStaff.forEach(s => { %>
                                        <tr>
                                            <td>
                                                <strong><%= s.fullname %></strong><br>
                                                <small class="text-dim"><%= s.email %></small>
                                            </td>
                                            <td>
                                                <span class="role-pill-badge <%= s.role %>"><%= s.role.toUpperCase() %></span>
                                            </td>
                                            <td><small><%= s.specialization || 'Clinical Services' %></small></td>
                                            <td>
                                                <span style="font-size: 11px; font-weight: 700; color: <%= s.isActive !== false ? '#34d399' : '#f87171' %>;">
                                                    <%= s.isActive !== false ? '● ACTIVE' : '○ INACTIVE' %>
                                                </span>
                                            </td>
                                            <td>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/staff/<%= s._id %>/toggle-active" method="POST" style="display:inline;">
                                                        <button type="submit" class="btn-sm-action checkin" title="Toggle Active Status">
                                                            <i class="fas fa-power-off"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/staff/<%= s._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove staff member <%= s.fullname %>?');">
                                                        <button type="submit" class="btn-sm-action cancel" title="Delete Account">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state-box">
                            <i class="fas fa-users-slash"></i>
                            <p>No staff accounts currently on file.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- TAB 4: PATIENT MANAGEMENT -->
        <div id="tab-patients" class="tab-pane-dark" style="<%= activeTab === 'patients' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-card-dark">
                <div class="card-head">
                    <h3><i class="fas fa-hospital-user text-cyan"></i> Hospital Patient Registry</h3>
                    <small>Registered patients with verified CareSync profile credentials</small>
                </div>

                <% if (patientsList.length > 0) { %>
                    <div class="table-scroll-wrap">
                        <table class="dash-table-dark">
                            <thead>
                                <tr>
                                    <th>Patient Full Name</th>
                                    <th>Registered Email</th>
                                    <th>Contact Phone</th>
                                    <th>Account Status</th>
                                    <th>Registered Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% patientsList.forEach(p => { %>
                                    <tr>
                                        <td><strong><%= p.fullname %></strong></td>
                                        <td><%= p.email %></td>
                                        <td><%= p.phone || 'N/A' %></td>
                                        <td><span class="status-pill scheduled">Active</span></td>
                                        <td><%= new Date(p.createdAt).toLocaleDateString() %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state-box">
                        <i class="fas fa-user-injured"></i>
                        <p>No patients currently registered in the database.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB 5: MASTER APPOINTMENTS LEDGER -->
        <div id="tab-appointments" class="tab-pane-dark" style="<%= activeTab === 'appointments' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-card-dark">
                <div class="card-head">
                    <h3><i class="fas fa-calendar-alt text-blue"></i> Master Hospital Appointments Ledger</h3>
                    <small>Operational overview of scheduled, completed, and cancelled visits</small>
                </div>

                <% if (masterAppointments.length > 0) { %>
                    <div class="table-scroll-wrap">
                        <table class="dash-table-dark">
                            <thead>
                                <tr>
                                    <th>Patient</th>
                                    <th>Attending Doctor</th>
                                    <th>Date & Slot</th>
                                    <th>Current Status</th>
                                    <th>Notes</th>
                                    <th>Admin Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% masterAppointments.forEach(appt => { %>
                                    <tr>
                                        <td><strong><%= appt.patientName %></strong></td>
                                        <td><%= appt.doctorName %></td>
                                        <td>
                                            <%= new Date(appt.date).toLocaleDateString() %><br>
                                            <small class="text-cyan"><%= appt.slot || appt.time %></small>
                                        </td>
                                        <td>
                                            <span class="status-pill <%= appt.status.toLowerCase().replace(/[^a-z]/g, '') %>">
                                                <%= appt.status %>
                                            </span>
                                        </td>
                                        <td><small class="text-dim"><%= appt.notes || 'Routine consultation' %></small></td>
                                        <td>
                                            <% if (appt.status !== 'Completed' && appt.status !== 'Cancelled') { %>
                                                <div style="display: flex; gap: 6px;">
                                                    <form action="/admin/appointments/<%= appt._id %>/status" method="POST" style="display:inline;">
                                                        <input type="hidden" name="status" value="No-Show">
                                                        <button type="submit" class="btn-sm-action cancel" style="font-size: 11px; padding: 4px 8px;" title="Mark No-Show">
                                                            No-Show
                                                        </button>
                                                    </form>
                                                    <form action="/admin/appointments/<%= appt._id %>/status" method="POST" style="display:inline;" onsubmit="return confirm('Cancel appointment?');">
                                                        <input type="hidden" name="status" value="Cancelled">
                                                        <button type="submit" class="btn-sm-action cancel" style="font-size: 11px; padding: 4px 8px;" title="Cancel">
                                                            Cancel
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } else { %>
                                                <span class="text-dim">—</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state-box">
                        <i class="fas fa-calendar-times"></i>
                        <p>No appointments recorded across the hospital ledger.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB 7: AUDIT LOGS -->
        <div id="tab-audit" class="tab-pane-dark" style="<%= activeTab === 'audit' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-card-dark">
                <div class="card-head">
                    <h3><i class="fas fa-history text-purple"></i> Institutional Security & Operational Audit Trail</h3>
                    <small>Immutable chronological log of administrative and clinical events</small>
                </div>

                <% if (typeof auditLogs !== 'undefined' && auditLogs && auditLogs.length > 0) { %>
                    <div class="table-scroll-wrap">
                        <table class="dash-table-dark">
                            <thead>
                                <tr>
                                    <th>Timestamp</th>
                                    <th>Action</th>
                                    <th>Category</th>
                                    <th>Actor</th>
                                    <th>Target / Reference</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% auditLogs.forEach(log => { %>
                                    <tr>
                                        <td>
                                            <span style="font-size: 12px; color: #94a3b8;">
                                                <%= new Date(log.timestamp).toLocaleDateString() %><br>
                                                <%= new Date(log.timestamp).toLocaleTimeString() %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="color: #f1f5f9;"><%= log.action %></strong>
                                        </td>
                                        <td>
                                            <span class="dept-badge <%= log.category === 'VERIFICATION' ? 'cyan' : log.category === 'APPOINTMENT' ? 'blue' : log.category === 'AUTH' ? 'purple' : 'emerald' %>">
                                                <%= log.category %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong><%= log.actorName %></strong><br>
                                            <small class="role-pill-badge <%= log.actorRole %>" style="font-size: 9px;"><%= log.actorRole.toUpperCase() %></small>
                                        </td>
                                        <td><span class="text-cyan"><%= log.target || '—' %></span></td>
                                        <td><small style="color: #cbd5e1;"><%= log.details || '—' %></small></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="empty-state-box">
                        <i class="fas fa-shield-alt"></i>
                        <p>No audit events logged yet.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- TAB 9: AI SYMPTOM TRIAGE & CLINICAL LEADS -->
        <div id="tab-triage" class="tab-pane-dark" style="<%= activeTab === 'triage' ? 'display: block;' : 'display: none;' %>">
            <div class="dash-card-dark">
                <div class="card-head">
                    <div>
                        <h3><i class="fas fa-robot text-cyan"></i> AI Symptom Triage Inquiries &amp; Specialist Referrals</h3>
                        <small>Hospital-wide log of patient triage interactions and recommended medical specialists</small>
                    </div>
                    <div class="head-actions">
                        <span class="badge-tag"><i class="fas fa-brain text-purple"></i> NLP Clinical Triage</span>
                    </div>
                </div>

                <% if (typeof allTriageLogs === 'undefined' || allTriageLogs.length === 0) { %>
                    <div class="empty-tab-state">
                        <div class="empty-icon"><i class="fas fa-robot"></i></div>
                        <h4>No AI Triage Records Recorded Yet</h4>
                        <p>When patients run symptom checks via the AI Symptom Checker, the clinical triage assessments and matched doctors will appear here in real time.</p>
                    </div>
                <% } else { %>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
                        <div style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 12px; padding: 18px;">
                            <div style="font-size: 13px; color: #38bdf8;"><i class="fas fa-notes-medical"></i> Total Triage Checks</div>
                            <div style="font-size: 26px; font-weight: 800; color: #f8fafc; margin-top: 4px;"><%= allTriageLogs.length %></div>
                        </div>
                        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 18px;">
                            <div style="font-size: 13px; color: #f87171;"><i class="fas fa-triangle-exclamation"></i> Emergency / High Urgency</div>
                            <div style="font-size: 26px; font-weight: 800; color: #ef4444; margin-top: 4px;">
                                <%= typeof highUrgencyTriageCount !== 'undefined' ? highUrgencyTriageCount : allTriageLogs.filter(t => t.urgency === 'high').length %>
                            </div>
                        </div>
                        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 12px; padding: 18px;">
                            <div style="font-size: 13px; color: #34d399;"><i class="fas fa-stethoscope"></i> Moderate / Low Risk</div>
                            <div style="font-size: 26px; font-weight: 800; color: #10b981; margin-top: 4px;">
                                <%= allTriageLogs.filter(t => t.urgency !== 'high').length %>
                            </div>
                        </div>
                    </div>

                    <div class="dash-table-wrapper">
                        <table class="dash-table-dark">
                            <thead>
                                <tr>
                                    <th>Date &amp; Time</th>
                                    <th>Patient Details</th>
                                    <th>Symptoms &amp; Notes</th>
                                    <th>Urgency &amp; Flags</th>
                                    <th>Suspected Diagnoses</th>
                                    <th>Recommended Specialty &amp; Doctors</th>
                                    <th>AI Clinical Summary</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% allTriageLogs.forEach((triage, tIdx) => { 
                                    const isHigh = triage.urgency === 'high';
                                    const isMod = triage.urgency === 'moderate';
                                    const triageJson = JSON.stringify(triage).replace(/'/g, "&#39;");
                                %>
                                    <tr>
                                        <td style="white-space: nowrap;">
                                            <strong><%= new Date(triage.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></strong>
                                            <small style="display: block; color: #94a3b8;"><%= new Date(triage.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></small>
                                        </td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 10px;">
                                                <div style="width: 34px; height: 34px; border-radius: 50%; background: <%= triage.patientId ? 'rgba(56, 189, 248, 0.15)' : 'rgba(148, 163, 184, 0.15)' %>; color: <%= triage.patientId ? '#38bdf8' : '#94a3b8' %>; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
                                                    <%= (triage.patientName || 'V')[0].toUpperCase() %>
                                                </div>
                                                <div>
                                                    <strong><%= triage.patientName %></strong>
                                                    <% if (triage.patientPhone) { %>
                                                        <small style="display: block; color: #34d399;"><i class="fas fa-phone-alt" style="font-size: 10px;"></i> <%= triage.patientPhone %></small>
                                                    <% } %>
                                                    <% if (triage.patientEmail) { %>
                                                        <small style="display: block; color: #94a3b8;"><%= triage.patientEmail %></small>
                                                    <% } %>
                                                    <span class="badge-tag" style="margin-top: 3px; font-size: 10px; padding: 2px 6px;">
                                                        <i class="fas <%= triage.patientId ? 'fa-id-badge text-cyan' : 'fa-user-clock text-amber' %>"></i>
                                                        <%= triage.patientId ? 'Registered Patient' : 'Walk-in Visitor' %>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div style="display: flex; flex-wrap: wrap; gap: 5px; max-width: 220px;">
                                                <% (triage.symptoms || []).forEach(sym => { %>
                                                    <span style="font-size: 11px; padding: 2px 7px; border-radius: 4px; background: rgba(56, 189, 248, 0.12); color: #7dd3fc; border: 1px solid rgba(56, 189, 248, 0.25);">
                                                        <%= sym %>
                                                    </span>
                                                <% }) %>
                                            </div>
                                            <% if (triage.description) { %>
                                                <p style="font-size: 12px; color: #cbd5e1; font-style: italic; margin-top: 6px; line-height: 1.35; max-width: 240px; background: rgba(15, 23, 42, 0.5); padding: 6px 8px; border-radius: 6px; border-left: 2px solid #38bdf8;">
                                                    "<%= triage.description %>"
                                                </p>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="status-pill <%= isHigh ? 'cancelled' : (isMod ? 'confirmed' : 'checked-in') %>" style="font-size: 11px;">
                                                <i class="fas <%= isHigh ? 'fa-triangle-exclamation' : 'fa-stethoscope' %>"></i>
                                                <%= (triage.urgency || 'MODERATE').toUpperCase() %>
                                            </span>
                                            <% if (triage.emergencyFlag) { %>
                                                <span style="display: block; color: #ef4444; font-size: 11px; font-weight: 700; margin-top: 3px;">
                                                    <i class="fas fa-bolt"></i> EMERGENCY
                                                </span>
                                            <% } %>
                                            <% if (triage.emergencyReason) { %>
                                                <small style="display: block; color: #f87171; font-size: 11px; margin-top: 3px; max-width: 180px;">
                                                    <%= triage.emergencyReason %>
                                                </small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (triage.primaryConditions && triage.primaryConditions.length > 0) { %>
                                                <div style="display: flex; flex-direction: column; gap: 4px; max-width: 200px;">
                                                    <% triage.primaryConditions.forEach(cond => { %>
                                                        <span style="font-size: 11.5px; padding: 3px 8px; border-radius: 4px; background: rgba(168, 85, 247, 0.12); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25); font-weight: 600;">
                                                            <i class="fas fa-notes-medical" style="font-size: 10px;"></i> <%= cond %>
                                                        </span>
                                                    <% }) %>
                                                </div>
                                            <% } else { %>
                                                <small style="color: #64748b;">Clinical Assessment</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (triage.recommendedSpecialties && triage.recommendedSpecialties.length > 0) { %>
                                                <strong style="color: #38bdf8; font-size: 13px; display: block;">
                                                    <%= triage.recommendedSpecialties.join(', ') %>
                                                </strong>
                                            <% } %>
                                            <% if (triage.suggestedDoctorNames && triage.suggestedDoctorNames.length > 0) { %>
                                                <small style="display: block; color: #34d399; margin-top: 3px; font-weight: 600;">
                                                    <i class="fas fa-user-md" style="font-size: 10px;"></i> <%= triage.suggestedDoctorNames.join(', ') %>
                                                </small>
                                            <% } %>
                                        </td>
                                        <td style="max-width: 280px;">
                                            <p class="triage-summary-cell" style="font-size: 12px; margin: 0; line-height: 1.45;">
                                                <%= triage.summary || 'Triage completed.' %>
                                            </p>
                                            <% if (triage.homeRemedyNote) { %>
                                                <div style="margin-top: 6px; font-size: 11px; color: #34d399; background: rgba(16, 185, 129, 0.1); padding: 4px 8px; border-radius: 4px;">
                                                    <i class="fas fa-heart"></i> <%= triage.homeRemedyNote %>
                                                </div>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="status-pill <%= triage.status === 'Reviewed' ? 'completed' : 'scheduled' %>" style="font-size: 11px;">
                                                <%= triage.status || 'New' %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                                <button type="button" class="btn-action-view" onclick="openTriageDetailModal('<%= triage._id %>')" style="padding: 5px 10px; font-size: 11px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3);">
                                                    <i class="fas fa-file-medical"></i> Full Details
                                                </button>
                                                <form method="POST" action="/admin/triage/<%= triage._id %>/status" style="margin: 0;">
                                                    <input type="hidden" name="status" value="<%= triage.status === 'Reviewed' ? 'New' : 'Reviewed' %>">
                                                    <button type="submit" class="btn-action-view" style="padding: 5px 10px; font-size: 11px; width: 100%;">
                                                        <i class="fas <%= triage.status === 'Reviewed' ? 'fa-undo' : 'fa-check' %>"></i>
                                                        <%= triage.status === 'Reviewed' ? 'Unmark' : 'Review' %>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</section>

<!-- MODAL: REQUEST MORE INFO FROM DOCTOR -->
<div id="requestInfoModal" class="modal-backdrop-dark" style="display: none;">
    <div class="modal-box-dark">
        <div class="modal-header">
            <h3><i class="fas fa-question-circle text-cyan"></i> Request Additional Documentation</h3>
            <button type="button" class="close-btn" onclick="closeInfoModal()">&times;</button>
        </div>
        <form id="infoForm" method="POST" class="modal-form">
            <div class="input-field">
                <label>Applicant Doctor</label>
                <input type="text" id="infoDocName" readonly class="modal-input readonly">
            </div>
            <div class="input-field">
                <label>Administrative Remarks / Required Information *</label>
                <textarea name="adminNotes" rows="4" class="dark-dash-textarea" placeholder="Specify required information: e.g. Please re-upload a clear copy of your state council license and degree certificate." required></textarea>
            </div>
            <button type="submit" class="btn-modal-submit">
                <i class="fas fa-paper-plane"></i> Send Request to Doctor
            </button>
        </form>
    </div>
</div>

<!-- MODAL: REJECT DOCTOR APPLICATION -->
<div id="rejectModal" class="modal-backdrop-dark" style="display: none;">
    <div class="modal-box-dark">
        <div class="modal-header">
            <h3><i class="fas fa-times-circle text-rose" style="color: #f87171;"></i> Reject Doctor Application</h3>
            <button type="button" class="close-btn" onclick="closeRejectModal()">&times;</button>
        </div>
        <form id="rejectForm" method="POST" class="modal-form">
            <div class="input-field">
                <label>Applicant Doctor</label>
                <input type="text" id="rejectDocName" readonly class="modal-input readonly">
            </div>
            <div class="input-field">
                <label>Reason for Rejection *</label>
                <textarea name="adminNotes" rows="4" class="dark-dash-textarea" placeholder="Specify reason: e.g. Qualifications could not be verified against the National Medical Commission registry." required></textarea>
            </div>
            <button type="submit" class="btn-modal-submit" style="background: #dc2626;">
                <i class="fas fa-ban"></i> Confirm Rejection
            </button>
        </form>
    </div>
</div>

<!-- MODAL: FULL CLINICAL TRIAGE DOSSIER -->
<div id="triageDetailModal" class="modal-backdrop-dark" style="display: none; align-items: center; justify-content: center; z-index: 9999;">
    <div class="modal-box-dark" style="max-width: 720px; width: 95%; max-height: 90vh; overflow-y: auto;">
        <div class="modal-header">
            <div>
                <h3><i class="fas fa-file-medical text-cyan"></i> Patient Clinical Triage Dossier</h3>
                <small id="mDateTime" style="color: #94a3b8; font-size: 12px;"></small>
            </div>
            <button type="button" class="close-btn" onclick="closeTriageDetailModal()">&times;</button>
        </div>
        <div style="padding: 20px 24px; display: flex; flex-direction: column; gap: 16px;">
            <!-- Patient Banner -->
            <div class="triage-modal-patient-card" style="border-radius: 10px; padding: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 14px;">
                    <div id="mAvatar" style="width: 44px; height: 44px; border-radius: 50%; background: rgba(56, 189, 248, 0.2); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800;">
                        P
                    </div>
                    <div>
                        <h4 id="mPatientName" style="margin: 0; font-size: 17px;"></h4>
                        <div id="mContact" style="font-size: 12.5px; margin-top: 3px;"></div>
                    </div>
                </div>
                <div id="mPatientBadge"></div>
            </div>

            <!-- Emergency Warning Banner (if emergency) -->
            <div id="mEmergencyBox" style="display: none; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; border-radius: 8px; padding: 12px 16px; color: #fca5a5;">
                <strong style="color: #ef4444; display: flex; align-items: center; gap: 8px;">
                    <i class="fas fa-triangle-exclamation"></i> Emergency Clinical Flag Detected
                </strong>
                <p id="mEmergencyReason" style="margin: 6px 0 0 0; font-size: 13px; color: #fecaca;"></p>
            </div>

            <!-- Clinical Urgency & Primary Conditions Grid -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
                <div class="triage-modal-info-box" style="padding: 14px; border-radius: 8px;">
                    <span style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Triage Priority Level</span>
                    <div id="mUrgencyPill" style="margin-top: 6px;"></div>
                </div>
                <div class="triage-modal-info-box" style="padding: 14px; border-radius: 8px;">
                    <span style="font-size: 11px; text-transform: uppercase; font-weight: 700;">Suspected Diagnoses</span>
                    <div id="mConditions" style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px;"></div>
                </div>
            </div>

            <!-- Reported Symptoms -->
            <div>
                <span class="triage-modal-section-title" style="font-size: 12px; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 8px;">
                    <i class="fas fa-notes-medical text-cyan"></i> Reported Symptoms
                </span>
                <div id="mSymptoms" style="display: flex; flex-wrap: wrap; gap: 6px;"></div>
            </div>

            <!-- Patient Written Description -->
            <div id="mNotesWrapper">
                <span class="triage-modal-section-title" style="font-size: 12px; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 6px;">
                    <i class="fas fa-comment-medical text-blue"></i> Patient's Stated Condition / Notes
                </span>
                <p id="mNotes" style="margin: 0; padding: 12px 14px; border-radius: 8px; border-left: 3px solid #38bdf8; font-size: 13px; font-style: italic; line-height: 1.5;"></p>
            </div>

            <!-- Specialist & Doctors Assigned -->
            <div class="triage-modal-specialty-box" style="padding: 14px 16px; border-radius: 8px;">
                <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 6px;">
                    <i class="fas fa-user-md"></i> Recommended Specialties &amp; Assigned Doctors
                </span>
                <div id="mSpecialties" style="font-size: 14px; font-weight: 700;"></div>
                <div id="mDoctors" style="font-size: 13px; margin-top: 4px;"></div>
            </div>

            <!-- AI Summary -->
            <div class="triage-modal-summary-box" style="padding: 14px 16px; border-radius: 8px;">
                <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 6px;">
                    <i class="fas fa-robot"></i> Clinical AI Assessment Summary
                </span>
                <p id="mSummary" style="margin: 0; font-size: 13.5px; line-height: 1.55;"></p>
            </div>

            <!-- Self-Care & Home Remedies (if present) -->
            <div id="mHomeRemedyWrapper" style="display: none; background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25); padding: 12px 14px; border-radius: 8px;">
                <span style="font-size: 12px; color: #34d399; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 4px;">
                    <i class="fas fa-heart"></i> Patient Self-Care &amp; Remedial Guidance
                </span>
                <p id="mHomeRemedy" style="margin: 0; font-size: 13px; color: #a7f3d0; line-height: 1.5;"></p>
            </div>
        </div>
        <div style="padding: 14px 24px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: flex-end; gap: 10px;">
            <button type="button" class="btn-action-view" onclick="closeTriageDetailModal()" style="padding: 8px 18px; font-size: 13px;">Close Dossier</button>
        </div>
    </div>
</div>

<script>
    function switchTab(tabName) {
        document.querySelectorAll('.tab-pane-dark').forEach(pane => pane.style.display = 'none');
        document.querySelectorAll('.dash-tab-btn').forEach(btn => btn.classList.remove('active'));

        const targetPane = document.getElementById('tab-' + tabName);
        if (targetPane) {
            targetPane.style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        const activeBtn = Array.from(document.querySelectorAll('.dash-tab-btn')).find(b => b.getAttribute('onclick') && b.getAttribute('onclick').includes(tabName));
        if (activeBtn) activeBtn.classList.add('active');

        const newUrl = window.location.pathname + '?tab=' + tabName;
        window.history.replaceState(null, '', newUrl);
        if (typeof window.updateActiveNavLinks === 'function') window.updateActiveNavLinks();
    }

    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('tab');
        if (tab && document.getElementById('tab-' + tab)) {
            switchTab(tab);
        }
    });

    function openInfoModal(docId, docName) {
        document.getElementById('infoForm').action = '/admin/doctors/' + docId + '/request-info';
        document.getElementById('infoDocName').value = docName;
        document.getElementById('requestInfoModal').style.display = 'flex';
    }

    function closeInfoModal() {
        document.getElementById('requestInfoModal').style.display = 'none';
    }

    function openRejectModal(docId, docName) {
        document.getElementById('rejectForm').action = '/admin/doctors/' + docId + '/reject';
        document.getElementById('rejectDocName').value = docName;
        document.getElementById('rejectModal').style.display = 'flex';
    }

    function closeRejectModal() {
        document.getElementById('rejectModal').style.display = 'none';
    }

    const allTriageRecords = <%- JSON.stringify(allTriageLogs || []) %>;

    function openTriageDetailModal(triageId) {
        const item = allTriageRecords.find(t => String(t._id) === String(triageId));
        if (!item) return;

        document.getElementById('mDateTime').textContent = new Date(item.createdAt).toLocaleString('en-US', {
            month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
        });

        document.getElementById('mPatientName').textContent = item.patientName || 'Anonymous Visitor';
        document.getElementById('mAvatar').textContent = (item.patientName || 'V')[0].toUpperCase();

        const contactParts = [];
        if (item.patientPhone) contactParts.push('📞 ' + item.patientPhone);
        if (item.patientEmail) contactParts.push('✉️ ' + item.patientEmail);
        document.getElementById('mContact').textContent = contactParts.join(' • ') || 'No contact details provided';

        document.getElementById('mPatientBadge').innerHTML = item.patientId
            ? '<span class="status-pill confirmed" style="font-size: 11px;"><i class="fas fa-check-circle"></i> Registered Patient</span>'
            : '<span class="status-pill scheduled" style="font-size: 11px;"><i class="fas fa-user-clock"></i> Walk-in Visitor</span>';

        const isHigh = item.urgency === 'high';
        const isMod = item.urgency === 'moderate';
        document.getElementById('mUrgencyPill').innerHTML = `
            <span class="status-pill ${isHigh ? 'cancelled' : (isMod ? 'confirmed' : 'checked-in')}" style="font-size: 13px;">
                <i class="fas ${isHigh ? 'fa-triangle-exclamation' : 'fa-stethoscope'}"></i>
                ${(item.urgency || 'MODERATE').toUpperCase()} PRIORITY
            </span>
        `;

        const emBox = document.getElementById('mEmergencyBox');
        if (item.emergencyFlag) {
            emBox.style.display = 'block';
            document.getElementById('mEmergencyReason').textContent = item.emergencyReason || 'Critical red-flag symptoms detected. Immediate medical intervention advised.';
        } else {
            emBox.style.display = 'none';
        }

        const conds = item.primaryConditions || [];
        document.getElementById('mConditions').innerHTML = conds.length > 0
            ? conds.map(c => `<span style="font-size: 11px; padding: 3px 8px; border-radius: 4px; background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); font-weight: 600;">${c}</span>`).join('')
            : '<span style="color: #64748b; font-size: 12px;">Standard Evaluation</span>';

        const syms = item.symptoms || [];
        document.getElementById('mSymptoms').innerHTML = syms.map(s => `
            <span style="font-size: 11.5px; padding: 3px 8px; border-radius: 4px; background: rgba(56, 189, 248, 0.12); color: #7dd3fc; border: 1px solid rgba(56, 189, 248, 0.25);">
                ${s}
            </span>
        `).join('');

        if (item.description && item.description.trim()) {
            document.getElementById('mNotesWrapper').style.display = 'block';
            document.getElementById('mNotes').textContent = `"${item.description.trim()}"`;
        } else {
            document.getElementById('mNotesWrapper').style.display = 'none';
        }

        document.getElementById('mSpecialties').textContent = (item.recommendedSpecialties || []).join(', ') || 'General Medicine';
        document.getElementById('mDoctors').textContent = (item.suggestedDoctorNames || []).length > 0
            ? 'Matched Physicians: ' + item.suggestedDoctorNames.join(', ')
            : 'Hospital-wide Clinical Routing';

        document.getElementById('mSummary').textContent = item.summary || 'Clinical assessment completed.';

        const remBox = document.getElementById('mHomeRemedyWrapper');
        if (item.homeRemedyNote && item.homeRemedyNote.trim()) {
            remBox.style.display = 'block';
            document.getElementById('mHomeRemedy').textContent = item.homeRemedyNote;
        } else {
            remBox.style.display = 'none';
        }

        document.getElementById('triageDetailModal').style.display = 'flex';
    }

    function closeTriageDetailModal() {
        document.getElementById('triageDetailModal').style.display = 'none';
    }
</script>
