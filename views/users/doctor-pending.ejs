<% layout('/layouts/boilerplate.ejs') %>

<div class="auth-container">
    <div class="auth-box doctor-pending-card">
        <div class="auth-header">
            <a href="/">
                <img src="/images/logo.png" alt="CareSync" class="auth-logo">
            </a>
            <span class="auth-tag doctor-pending-tag">
                <i class="fas fa-hourglass-half"></i> Status: PENDING VERIFICATION
            </span>
            <h2 class="auth-title">Application Submitted</h2>
            <p class="auth-subtitle">
                Thank you, <strong><%= doctor.fullname %></strong>. Your medical credentials have been forwarded to the hospital administration.
            </p>
        </div>

        <div class="pending-detail-box">
            <div class="pending-row">
                <span class="pending-lbl">Medical Specialty:</span>
                <strong class="pending-val text-cyan"><%= doctor.specialization %></strong>
            </div>
            <div class="pending-row">
                <span class="pending-lbl">Registration / License #:</span>
                <strong class="pending-val text-primary"><%= doctor.licenseNumber %></strong>
            </div>
            <div class="pending-row">
                <span class="pending-lbl">Authority:</span>
                <span class="pending-val text-muted"><%= doctor.registrationAuthority %></span>
            </div>
            <div class="pending-row">
                <span class="pending-lbl">Consultation Fee:</span>
                <strong class="pending-val text-emerald">₹<%= doctor.consultationFee %></strong>
            </div>
            <div class="pending-row pending-status-row">
                <span class="pending-lbl">Account Status:</span>
                <span class="pending-status-text">AWAITING ADMIN APPROVAL</span>
            </div>
        </div>

        <div class="auth-alert-info pending-info-alert">
            <i class="fas fa-info-circle"></i>
            <div>
                <strong>What happens next?</strong>
                <p>
                    The hospital administrative team is reviewing your credentials. Once your application is approved, your Healthcare Staff Dashboard will be activated and you can sign in to manage consultations.
                </p>
            </div>
        </div>

        <div class="pending-actions-row">
            <a href="/doctor/login" class="auth-btn doctor-btn btn-pending-login">
                <i class="fas fa-sign-in-alt"></i> Doctor Sign In Portal
            </a>
            <a href="/" class="auth-btn btn-pending-return">
                <i class="fas fa-home"></i> Return Home
            </a>
        </div>
    </div>
</div>
