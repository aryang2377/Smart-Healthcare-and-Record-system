<% layout('/layouts/boilerplate.ejs') %>

<div class="auth-container">
    <div class="auth-box register-box">
        <div class="auth-header">
            <a href="/" class="auth-logo-link">
                <img src="/images/logo.png" alt="CareSync" class="auth-logo">
            </a>
            <span class="auth-tag patient">
                <i class="fas fa-user-plus"></i> Patient Registration
            </span>
            <h2 class="auth-title">Register as Patient</h2>
            <p class="auth-subtitle">Create your personal account to schedule visits and view doctor test reports</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="auth-alert-error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <form action="/register" method="POST" class="auth-form">
            <div class="form-group">
                <label for="regFullname">Full Name</label>
                <input
                    type="text"
                    id="regFullname"
                    name="fullname"
                    placeholder="e.g. John Doe"
                    required
                    autocomplete="name"
                >
            </div>

            <div class="form-group">
                <label for="regEmail">Email Address</label>
                <input
                    type="email"
                    id="regEmail"
                    name="email"
                    placeholder="e.g. john@example.com"
                    required
                    autocomplete="email"
                >
            </div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label for="regPassword">Password</label>
                    <div class="password-wrap">
                        <input
                            type="password"
                            id="regPassword"
                            name="password"
                            placeholder="At least 6 chars"
                            required
                            minlength="6"
                            autocomplete="new-password"
                        >
                        <button
                            type="button"
                            class="eye-btn"
                            onclick="togglePwd('regPassword', this)"
                            aria-label="Toggle password"
                        >
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="regConfirmPassword">Confirm Password</label>
                    <div class="password-wrap">
                        <input
                            type="password"
                            id="regConfirmPassword"
                            name="confirmPassword"
                            placeholder="Re-enter password"
                            required
                            autocomplete="new-password"
                        >
                        <button
                            type="button"
                            class="eye-btn"
                            onclick="togglePwd('regConfirmPassword', this)"
                            aria-label="Toggle password"
                        >
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="auth-btn">
                <i class="fas fa-user-check"></i> Complete Patient Registration
            </button>
        </form>

        <div class="auth-switch-section">
            <div class="auth-switch-row">
                <span>Already have an account?</span>
                <a href="/login" class="auth-link-bold">
                    Login to Account <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            <div class="auth-switch-footer">
                <span class="auth-footer-tag">Healthcare Professional?</span>
                <div class="auth-pill-group">
                    <a href="/doctor/apply" class="auth-pill-btn doctor">
                        <i class="fas fa-user-md"></i> Apply as Doctor
                    </a>
                    <a href="/doctor/login" class="auth-pill-btn subtle">
                        <i class="fas fa-stethoscope"></i> Staff Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function togglePwd(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (!input || !icon) return;
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
    }
}

const regForm = document.querySelector('.auth-form');
if (regForm) {
    regForm.addEventListener('submit', function (e) {
        const name = document.getElementById('regFullname');
        const email = document.getElementById('regEmail');
        const pass = document.getElementById('regPassword');
        const confirmPass = document.getElementById('regConfirmPassword');

        if (!name.value.trim()) {
            e.preventDefault();
            showModernAlert('Please enter your full name.', 'warning', { title: 'Full Name Required', targetInput: name });
            return false;
        }
        if (!email.value.trim() || !email.value.includes('@')) {
            e.preventDefault();
            showModernAlert('Please enter a valid email address.', 'warning', { title: 'Valid Email Required', targetInput: email });
            return false;
        }
        if (!pass.value || pass.value.length < 6) {
            e.preventDefault();
            showModernAlert('Password must be at least 6 characters long.', 'warning', { title: 'Password Too Short', targetInput: pass });
            return false;
        }
        if (pass.value !== confirmPass.value) {
            e.preventDefault();
            showModernAlert('Passwords do not match. Please ensure both passwords match.', 'error', { title: 'Password Mismatch', targetInput: confirmPass });
            return false;
        }

        try {
            sessionStorage.setItem('caresync_toast', JSON.stringify({
                title: 'Success',
                message: 'Patient Account Created Successfully',
                type: 'success'
            }));
        } catch (err) {}
    });
}

<% if (typeof error !== 'undefined' && error) { %>
document.addEventListener('DOMContentLoaded', function () {
    showModernAlert(<%- JSON.stringify(error) %>, 'error', { title: 'Registration Notice' });
});
<% } %>
</script>
