# Server Port
PORT=4000

# MongoDB Database Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/CareSync
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/CareSync?retryWrites=true&w=majority

# JWT Token Secret for Session Authentication
JWT_SECRET=YourSuperSecretKey_CareSync2026

# System Administrator Credentials (Only single admin in .env, synced on server startup)
ADMIN_EMAIL=admin@caresync.health
ADMIN_PASSWORD=AdminCareSync@2026
ADMIN_NAME=Hospital Administrator
